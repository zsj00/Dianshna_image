# ============================================================
# MeituEcomAgent 环境变量示例
# 复制为 .env 后填入真实密钥；不要提交 .env。
# ============================================================

# ---- Chat/Vision/Embedding: OpenAI-compatible API ----
# 阿里云百炼兼容模式示例；也可替换为 OpenAI 或其他 OpenAI-compatible 地址。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
CHAT_MODEL=qwen-plus
VISION_MODEL=qwen-vl-max
EMBEDDING_MODEL=text-embedding-v3

# ---- 图片生成 Provider ----
# 生产推荐 dashscope；OpenAI-compatible 图片接口可改为 cloud；本地 ComfyUI/dev 改为 comfyui。
IMAGE_PROVIDER=dashscope
IMAGE_MODEL=dall-e-3
CLOUD_IMAGE_SIZE=1024x1024
CLOUD_IMAGE_RESPONSE_FORMAT=b64_json
IMAGE_PROVIDER_TIMEOUT=300

# ---- 阿里云百炼通义万相图片生成 ----
# 如果 OPENAI_API_KEY 已填百炼 key，也建议这里填同一个 key，便于图片 provider 独立切换。
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
DASHSCOPE_IMAGE_SIZE=1024*1024
DASHSCOPE_IMAGE_POLL_INTERVAL=2

# ---- 可选本地 ComfyUI/dev 能力 ----
COMFYUI_ENABLED=false
COMFYUI_SERVER_ADDRESS=host.docker.internal:8188
ENABLE_LOCAL_PREPROCESSING=false
U2NET_HOME=./.data/u2net

# ---- 路径配置：建议保持在 D 盘仓库目录内 ----
RAG_PERSIST_DIR=./.data/knowledge_base_index
OUTPUT_DIR=./output
KNOWLEDGE_BASE_DIR=./knowledge_base
WORKFLOW_DIR=./workflows

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
